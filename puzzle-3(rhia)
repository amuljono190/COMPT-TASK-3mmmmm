import random


def print_board(board):
    """Displays the current state of the 3-by-3 game board."""

    # Prints the nine board positions in three rows.
    print(f"\n {board[0]} | {board[1]} | {board[2]} ")
    print("---|---|---")
    print(f" {board[3]} | {board[4]} | {board[5]} ")
    print("---|---|---")
    print(f" {board[6]} | {board[7]} | {board[8]} \n")


def check_win(board, player):
    """Checks whether a player has three matching symbols in a line."""

    # Lists all possible winning rows, columns and diagonals.
    win_conditions = [
        [0, 1, 2], [3, 4, 5], [6, 7, 8],  # Rows
        [0, 3, 6], [1, 4, 7], [2, 5, 8],  # Columns
        [0, 4, 8], [2, 4, 6]              # Diagonals
    ]

    # Returns True if any winning combination belongs to the player.
    return any(
        all(board[cell] == player for cell in combo)
        for combo in win_conditions
    )


def is_board_full(board):
    """Checks whether all nine board positions are occupied."""

    # A full board contains only X and O symbols.
    return all(cell in ["X", "O"] for cell in board)


def get_computer_move(board, computer, human):
    """Chooses the computer's move using a simple strategic approach."""

    # Strategy 1: Check whether the computer can win immediately.
    for i in range(9):
        if board[i] not in ["X", "O"]:
            # Makes a temporary copy so the real board is not changed.
            board_copy = board.copy()
            board_copy[i] = computer

            # Returns the position if it creates a winning combination.
            if check_win(board_copy, computer):
                return i

    # Strategy 2: Block the human if they could win on their next move.
    for i in range(9):
        if board[i] not in ["X", "O"]:
            # Temporarily tests the position using the human's symbol.
            board_copy = board.copy()
            board_copy[i] = human

            # Uses the position to prevent the human from winning.
            if check_win(board_copy, human):
                return i

    # Strategy 3: Take the centre square if it is available.
    if board[4] not in ["X", "O"]:
        return 4

    # Strategy 4: Choose a random available corner.
    corners = [0, 2, 6, 8]
    available_corners = [
        i for i in corners if board[i] not in ["X", "O"]
    ]

    if available_corners:
        return random.choice(available_corners)

    # Strategy 5: Choose a random available side.
    sides = [1, 3, 5, 7]
    available_sides = [
        i for i in sides if board[i] not in ["X", "O"]
    ]

    if available_sides:
        return random.choice(available_sides)

    # Returns None if no moves are available.
    return None


def play_game():
    """Runs Tic-Tac-Toe and returns the result of the game."""

    # Creates the board with positions numbered from 1 to 9.
    board = [str(i) for i in range(1, 10)]

    # Assigns X to the human and O to the computer.
    human = "X"
    computer = "O"

    print("Welcome to Tic-Tac-Toe!")
    print("You are 'X' and the computer is 'O'.")
    print_board(board)

    # Repeats the turns until someone wins or the game ends in a draw.
    while True:

        # HUMAN TURN: Keep asking until a valid move is entered.
        while True:
            try:
                # Converts the chosen position to a zero-based index.
                move = int(input("Choose a position (1-9): ")) - 1

                # Checks that the position is on the board and unoccupied.
                if 0 <= move <= 8 and board[move] not in ["X", "O"]:
                    board[move] = human
                    break
                else:
                    print("Invalid move. Spot already taken or out of range.")

            # Handles letters and other inputs that cannot be converted to integers.
            except ValueError:
                print("Please enter a valid number between 1 and 9.")

        # Displays the board after the human's move.
        print_board(board)

        # Checks whether the human has won.
        if check_win(board, human):
            print("Congratulations! You won!")
            return True

        # Checks whether the human's move filled the final square.
        if is_board_full(board):
            print("It's a draw! You did not defeat the computer.")
            return False

        # COMPUTER TURN: Selects and makes the computer's move.
        print("Computer is thinking...")
        comp_move = get_computer_move(board, computer, human)

        # Handles the unlikely case where no moves remain.
        if comp_move is None:
            print("It's a draw!")
            return False

        board[comp_move] = computer

        # Displays the board after the computer's move.
        print_board(board)

        # Checks whether the computer has won.
        if check_win(board, computer):
            print("Computer wins! Better luck next time.")
            return False

        # Checks whether the computer's move filled the final square.
        if is_board_full(board):
            print("It's a draw! You did not defeat the computer.")
            return False


# Allows Tic-Tac-Toe to be tested independently of the main game.
if __name__ == "__main__":
    play_game()
