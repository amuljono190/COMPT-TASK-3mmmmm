
import random

def play_game():
    # Create an empty board for Tic-Tac-Toe.
    board = [" "] * 9

    # Display the Tic-Tac-Toe board with position numbers for reference.
    def display_board():
        print()
        print(" " + board[0] + " | " + board[1] + " | " + board[2])
        print("---+---+---")
        print(" " + board[3] + " | " + board[4] + " | " + board[5])
        print("---+---+---")
        print(" " + board[6] + " | " + board[7] + " | " + board[8])
        print()

    # Check whether a player has won.
    def check_winner(symbol):
        winning_combinations = [
            [0, 1, 2], [3, 4, 5], [6, 7, 8],
            [0, 3, 6], [1, 4, 7], [2, 5, 8],
            [0, 4, 8], [2, 4, 6]
        ]

        for combination in winning_combinations:
            if all(board[position] == symbol for position in combination):
                return True

        return False

    # Keep playing rounds until the player wins.
    while True:
        # Reset the board at the beginning of each round.
        board = [" "] * 9

        print("Welcome to Puzzle 3: Tic-Tac-Toe!")
        print("You are X and the computer is O.")
        print("Choose a position from 1 to 9.")
        print()
        print("Positions:")
        print(" 1 | 2 | 3")
        print("---+---+---")
        print(" 4 | 5 | 6")
        print("---+---+---")
        print(" 7 | 8 | 9")

        # Display the board once before the game begins.
        display_board()

        # Continue playing until someone wins or the board is full.
        while True:
            # Ask the player to choose a position.
            try:
                move = int(input("Choose a position (1-9): ").strip()) - 1
            except ValueError:
                print("Please enter a number from 1 to 9.")
                continue

            # Check that the position is valid and empty.
            if move < 0 or move > 8 or board[move] != " ":
                print("Invalid move! Choose an empty position from 1 to 9.")
                continue

            # Place the player's symbol on the board.
            board[move] = "X"

            # Update the existing board instead of printing a new one.
            print("\033[7A", end="")
            display_board()

            # Check whether the player has won.
            if check_winner("X"):
                print("Congratulations! You beat the computer!")
                print("You can proceed to the next room.")
                return True

            # Check whether the board is full after the player's move.
            if all(space != " " for space in board):
                print("It's a tie! Starting a new round...")
                break

            # The computer deliberately chooses a random empty position.
            # It does not try to win or block the player's winning moves.
            available_positions = [
                position for position in range(9)
                if board[position] == " "
            ]

            computer_move = random.choice(available_positions)

            # Place the computer's symbol on the board.
            board[computer_move] = "O"
            print("The computer chose position", computer_move + 1)

            # Update the existing board after the computer's move.
            print("\033[7A", end="")
            display_board()

            # Check whether the computer has won.
            if check_winner("O"):
                print("The computer won! Starting a new round...")
                break

            # Check whether the board is full after the computer's move.
            if all(space != " " for space in board):
                print("It's a tie! Starting a new round...")
                break
