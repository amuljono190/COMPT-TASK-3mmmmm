
import random
import os

def play_game():
    # Create an empty board
    board = [" "] * 9

    # Display the Tic-Tac-Toe board
    def display_board():
        os.system('cls' if os.name == 'nt' else 'clear')

        print("\nWelcome to Puzzle 3: Tic-Tac-Toe!")
        print("You are X and the computer is O.")
        print("Choose a position from 1 to 9.")
        print("Beat the computer to escape the caves!\n")

        print(" " + board[0] + " | " + board[1] + " | " + board[2])
        print("---+---+---")
        print(" " + board[3] + " | " + board[4] + " | " + board[5])
        print("---+---+---")
        print(" " + board[6] + " | " + board[7] + " | " + board[8])
        print()

    # Check whether a player has won
    def check_winner(symbol):
        winning_combinations = [
            [0, 1, 2], [3, 4, 5], [6, 7, 8],
            [0, 3, 6], [1, 4, 7], [2, 5, 8],
            [0, 4, 8], [2, 4, 6]
        ]

        for combination in winning_combinations:
            if all(board[position] == symbol for position in combination):
                return True

        return False

    # Keep playing until the player wins or the computer wins
    while True:
        board = [" "] * 9

        # Continue playing the round
        while True:
            display_board()

            # Ask the player to choose a position
            try:
                move = int(input("Choose a position (1-9): ")) - 1
            except ValueError:
                print("Please enter a number from 1 to 9.")
                input("Press Enter to continue...")
                continue

            # Check that the position is valid and empty
            if move < 0 or move > 8 or board[move] != " ":
                print("Invalid move! Choose an empty position from 1 to 9.")
                input("Press Enter to continue...")
                continue

            # Place the player's symbol
            board[move] = "X"

            # Check whether the player has won
            if check_winner("X"):
                display_board()
                print("YOU WIN!")
                print("Congratulations! You can proceed to the next room.")
                return True

            # Check whether the board is full
            if all(space != " " for space in board):
                display_board()
                print("It's a tie! Starting a new round...")
                input("Press Enter to continue...")
                break

            # Computer randomly chooses an empty position
            available_positions = [
                position for position in range(9)
                if board[position] == " "
            ]

            computer_move = random.choice(available_positions)
            board[computer_move] = "O"

            # Check whether the computer has won
            if check_winner("O"):
                display_board()
                print("The computer chose position", computer_move + 1)
                print("The computer won!")
                print("GAME OVER!")
                return False

            # Check whether the board is full after the computer's move
            if all(space != " " for space in board):
                display_board()
                print("The computer chose position", computer_move + 1)
                print("It's a tie! Starting a new round...")
                input("Press Enter to continue...")
                break


# Start the game
play_game()
