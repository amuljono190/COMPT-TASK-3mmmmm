import random
import os


def clear_screen():
    """Clears the terminal screen."""
    os.system("cls" if os.name == "nt" else "clear")


def play_rps():
    """Runs Rock Paper Scissors and returns True when the player wins."""

    choices = ["rock", "paper", "scissors"]

    while True:
        player_score = 0
        monster_score = 0

        clear_screen()
        print("ROCK PAPER SCISSORS")
        print("You are fighting the monster!")
        print("First to 3 points wins!")
        print()

        while player_score < 3 and monster_score < 3:
            print("Choose:")
            print("1. Rock")
            print("2. Paper")
            print("3. Scissors")

            player_choice = input("Enter 1, 2, or 3: ").strip()

            if player_choice == "1":
                player = "rock"
            elif player_choice == "2":
                player = "paper"
            elif player_choice == "3":
                player = "scissors"
            else:
                print("Invalid choice. Try again!\n")
                continue

            if random.random() < 0.8:
                if player == "paper":
                    monster = "rock"
                elif player == "scissors":
                    monster = "paper"
                else:
                    monster = "scissors"
            else:
                monster = random.choice(choices)

            print()
            print("You chose:", player)
            print("The monster chose:", monster)
            print()

            if player == monster:
                print("It's a tie!")

            elif (
                (player == "rock" and monster == "scissors")
                or (player == "paper" and monster == "rock")
                or (player == "scissors" and monster == "paper")
            ):
                print(f"{player.capitalize()} beats {monster}! You win!")
                player_score += 1

            else:
                print("The monster wins!")
                monster_score += 1

            print()
            print("Your score:", player_score)
            print("Monster score:", monster_score)
            print("--------------------------------")

            # Wait for the player to read the result.
            input("\nPress Enter to continue to the next round...")

            # Clear the board before the next round.
            clear_screen()

            # Display the game title and current scores again.
            print("ROCK PAPER SCISSORS")
            print("You are fighting the monster!")
            print("First to 3 points wins!")
            print()
            print("Your score:", player_score)
            print("Monster score:", monster_score)
            print("--------------------------------")
            print()

        if player_score == 3:
            print("YOU DEFEATED THE MONSTER!")
            print("You can now proceed to the next chamber!")
            return True

        else:
            # The player has lost the puzzle.
            print("THE MONSTER DEFEATED YOU!")
            print("The monster catches you...")
            print("You must return to the beginning of the cave!")

            # Return False to tell intro.py that the player lost.
            return False


if __name__ == "__main__":
    play_rps()
