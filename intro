
import sys
import time

# Import the puzzle functions and ending.
from puzzle1 import play_hangman
from puzzle2 import play_rps
from puzzle3 import play_game
from ending import cave_ending


def typewriter(text, speed=0.03):
    """Displays text one character at a time."""
    for char in text:
        sys.stdout.write(char)
        sys.stdout.flush()
        time.sleep(speed)
    print()


def start_intro():
    """Runs the introduction and controls the escape-room story."""

    # Displays the title and cave artwork.
    print("=" * 55)
    print(r"""
      /\    
     /  \       THE IJNAMUJ CAVES
    / /\ \      A Python Text Adventure
   /_/  \_\     Escape Room
    """)
    print("=" * 55 + "\n")

    # Welcomes the player and asks for their character's name.
    typewriter("Welcome, adventurer!!")
    player_name = input("Enter your character's name: ").strip()

    while not player_name:
        print("A name is required to continue.")
        player_name = input("Enter your character's name: ").strip()

    # Introduces the cave.
    print("\n" + "-" * 55 + "\n")
    typewriter(f"Greetings, {player_name}.")
    typewriter("You stand before the entrance of a mysterious cave.")
    typewriter("A chilling breeze comes from within the cave, echoing inside.")
    typewriter("Ahead, the entrance splits into two different passages.")
    print("\n" + "-" * 55 + "\n")

    # Lets the player choose a tunnel.
    while True:
        print("\nWhich pathway will you take?")
        print("1. Take the Left Tunnel (a narrow path lit by glowing blue moss)")
        print("2. Take the Right Tunnel (a dark path that echoes with water drops)")

        choice = input("\nEnter your choice (1 or 2): ").strip()

        if choice == "1":
            print()
            typewriter("You step cautiously into the glowing left tunnel...")
            typewriter(
                "The moss provides just enough light to guide your steps safely forward."
            )
            break

        elif choice == "2":
            print()
            typewriter(
                "You enter the right tunnel, water dripping from stalactites "
                "echo through the darkness."
            )
            typewriter(
                "It's near pitch black and the passage grows steep underneath your feet."
            )
            typewriter(
                "Feeling around with only your hands, you suddenly hit a wall "
                "Inspecting closer, you find a sliver of light, peeeking through a tiny crack of a rock."
            )
            typewriter(
                "You push the loose rock and squeeze yourself through, entering into another chamber."
            )
            print("-" * 55)

        else:
            print("\n[Invalid choice! Please type 1 or 2.]")

    # Introduces the chambers.
    print("\n" + "=" * 55 + "\n")
    typewriter(
        "As you cross into the inner chamber, a sharp pain appears in your stomach."
    )
    typewriter(
        "You see three chambers, with the first showing a stone carving of an apple."
    )
    print("\n" + "=" * 55 + "\n")

    typewriter(
        f"{player_name}, to obtain food, you must solve the first puzzle."
    )

    # PUZZLE 1: Hangman.
    input("\nPress Enter to begin Puzzle 1...")
    print("\n" + "=" * 55)
    print("PUZZLE 1: THE FRUIT WORD")
    print("=" * 55)

    play_hangman()

    # PUZZLE 2: Rock Paper Scissors.
    input("\nPress Enter to begin Puzzle 2...")
    print("\n" + "=" * 55)
    print("PUZZLE 2: THE MONSTER'S CHALLENGE")
    print("=" * 55)

    # Stop the story if the player loses Puzzle 2.
    if not play_rps():
        print("\n" + "=" * 55)
        print("YOU HAVE BEEN DEFEATED!")
        print("The monster sends you back to the beginning of the cave.")
        print("=" * 55)
        return

    # PUZZLE 3: Tic-Tac-Toe.
    input("\nPress Enter to begin Puzzle 3...")
    print("\n" + "=" * 55)
    print("PUZZLE 3: THE FINAL GRID")
    print("=" * 55)

    # Stop if Puzzle 3 is lost, provided play_game returns False on a loss.
    result = play_game()
    if result is False:
        print("\nYou failed the final puzzle. Your adventure ends here.")
        return

    # Ending only runs after the player completes all three puzzles.
    cave_ending(player_name)


# Runs the introduction when this file is started.
if __name__ == "__main__":
    start_intro()
