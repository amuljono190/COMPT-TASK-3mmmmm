import random
import os

def play_hangman():
    # List of words for the hangman game for the player to guess
    words = ["apple", "banana", "mango", "orange", "grapes", "strawberry", "kiwi", "watermelon", "pineapple", "peach"]

    word = random.choice(words)
    guessed = []
    wrong_guesses = 0
    max_attempts = 6

    # Visual hangman stages for each wrong guess
    hangman = [
        """
         -----
         |   |
             |
             |
             |
        =========
        """,
        """
         -----
         |   |
         O   |
             |
             |
        =========
        """,
        """
         -----
         |   |
         O   |
         |   |
             |
        =========
        """,
        """
         -----
         |   |
         O   |
        /|\\  |
             |
        =========
        """,
        """
         -----
         |   |
         O   |
        /|\\  |
        /    |
        =========
        """,
        """
         -----
         |   |
         O   |
        /|\\  |
        / \\  |
        =========
        """
    ]

    print("Guess the word!")
    print("Hint: The word is a fruit.")

    # Keep playing while the player has attempts remaining
    while wrong_guesses < max_attempts:

        display = ""

        # Show guessed letters and blanks for letters not yet guessed
        for letter in word:
            if letter in guessed:
                display += letter + " "
            else:
                display += "_ "

        # Clear the screen before showing the updated game
        os.system('cls' if os.name == 'nt' else 'clear')

        print(hangman[wrong_guesses])
        print("Word:", display)

        # Ask the player to enter a letter
        guess = input("Guess a letter: ").lower()

        # Check that the input contains exactly one letter
        if len(guess) != 1 or not guess.isalpha():
            print("Please enter one letter.")
            input("Press Enter to continue...")
            continue

        # Check whether the player has already guessed the letter
        if guess in guessed:
            print("You already guessed that letter.")
            input("Press Enter to continue...")
            continue

        # Save the new guess
        guessed.append(guess)

        # Check whether the guessed letter is in the word
        if guess in word:
            print("Correct guess!")
            # Check whether the player has guessed every letter
            if all(char in guessed for char in word):
                os.system('cls' if os.name == 'nt' else 'clear')
                print(hangman[wrong_guesses])
                print("Word:", " ".join(word))
                print("\nCongratulations! You have won and successfully acquired food!")
                print("You completed the puzzle and can now proceed to the next room.")
                return True
        else:
            wrong_guesses = wrong_guesses + 1
            print("Wrong guess!")

        input("Press Enter to continue...")

    # Display the final hangman and end the game if attempts run out
    os.system('cls' if os.name == 'nt' else 'clear')
    print(hangman[-1])
    print("Game Over!")
    print("You were starving and failed to guess the word.")
    print("The word was:", word)

    return False
