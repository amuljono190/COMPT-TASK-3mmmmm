import random
import os


def clear_screen():
    os.system("cls" if os.name == "nt" else "clear")


def print_board(board):
    """Prints the current state of the game board."""
    print("\n")
    print(f" {board[0]} | {board[1]} | {board[2]} ")
    print("---|---|---")
    print(f" {board[3]} | {board[4]} | {board[5]} ")
    print("---|---|---")
    print(f" {board[6]} | {board[7]} | {board[8]} ")
    print("\n")


def check_winner(board, player):
    """Checks if the given player has won the game."""
    win_conditions = [
        [0, 1, 2], [3, 4, 5], [6, 7, 8],
        [0, 3, 6], [1, 4, 7], [2, 5, 8],
        [0, 4, 8], [2, 4, 6]
    ]

    for condition in win_conditions:
        if all(board[position] == player for position in condition):
            return True

    return False


def is_board_full(board):
    # Returns True if all positions are taken.
    return all(space in ["X", "O"] for space in board)


def play_game():
   # Starts the Tic-Tac-Toe game and handles the game loop.
    print("Welcome to Tic-Tac-Toe!")
    print("You are X and the computer is O.")
    print("Positions are numbered 1 through 9:")
    print_board([str(i) for i in range(1, 10)])

    board = [" "] * 9

    while True:
        # Player's turn
        print_board(board)

        try:
            move = int(input("Choose a position (1-9): ")) - 1

            if move < 0 or move > 8:
                print("Invalid input. Choose a number from 1 to 9.")
                continue

            if board[move] != " ":
                print("That position is already taken. Try again.")
                continue

        except ValueError:
            print("Please enter a valid number.")
            continue

        board[move] = "X"

        # Check if the player wins
        if check_winner(board, "X"):
            print_board(board)
            print("Congratulations! You have successfully completed the puzzle!")
            print("You may now proceed to the next room.")
            return True

        if is_board_full(board):
            print_board(board)
            print("It's a tie! Try again to complete the puzzle.")
            input("Press Enter to play another round...")
            board = [" "] * 9
            continue

        # Computer's turn
        available_positions = [
            position for position in range(9)
            if board[position] == " "
        ]

        if not available_positions:
            continue

        if random.random() < 0.2:
            winning_moves = []

            for position in available_positions:
                board[position] = "O"

                if check_winner(board, "O"):
                    winning_moves.append(position)

                board[position] = " "

            if winning_moves:
                computer_move = random.choice(winning_moves)
            else:
                computer_move = random.choice(available_positions)
        else:
            computer_move = random.choice(available_positions)

        board[computer_move] = "O"
        print("The computer chose position", computer_move + 1)

        # Check if the computer wins
        if check_winner(board, "O"):
            print_board(board)
            print("DEFEAT! The monster has beaten you!")
            print("You must try again before you can proceed.")
            input("Press Enter to try again...")
            board = [" "] * 9
            clear_screen()
            print("Welcome to Tic-Tac-Toe!")
            print("You are X and the computer is O.")
            continue

        # Check for a tie
        if is_board_full(board):
            print_board(board)
            print("It's a tie! Try again to complete the puzzle.")
            input("Press Enter to play another round...")
            board = [" "] * 9
            clear_screen()
            print("Welcome to Tic-Tac-Toe!")
            print("You are X and the computer is O.")


if __name__ == "__main__":
    play_game()
