import random
import os

words = ["apple", "banana", "mango", "orange", "grapes",
         "strawberry", "kiwi", "watermelon", "pineapple", "peach"]

word = random.choice(words)
guessed = []
wrong_guesses = 0
max_attempts = 6
message = "Guess a letter:"

hangman = [
    """
     -----
     |   |
         |
         |
         |
    =========
    """,
    """
     -----
     |   |
     O   |
         |
         |
    =========
    """,
    """
     -----
     |   |
     O   |
     |   |
         |
    =========
    """,
    """
     -----
     |   |
     O   |
    /|\\  |
         |
    =========
    """,
    """
     -----
     |   |
     O   |
    /|\\  |
    /    |
    =========
    """,
    """
     -----
     |   |
     O   |
    /|\\  |
    / \\  |
    =========
    """
]


def clear_screen():
    os.system('cls' if os.name == 'nt' else 'clear')


while wrong_guesses < max_attempts:

    clear_screen()

    display = ""

    for letter in word:
        if letter in guessed:
            display += letter + " "
        else:
            display += "_ "

    print(hangman[wrong_guesses])
    print("Word:", display)
    print(message)

    if "_" not in display:
        print("\nCongratulations! You won!")
        print("You completed the puzzle and can now proceed to the next room.")
        break

    guess = input("\nEnter a letter: ").lower()

    if len(guess) != 1 or not guess.isalpha():
        message = "Please enter one letter."
        continue

    if guess in guessed:
        message = "You already guessed that letter."
        continue

    guessed.append(guess)

    if guess in word:
        message = "Correct guess!"
    else:
        wrong_guesses += 1
        message = "Wrong guess!"

else:
    clear_screen()
    print(hangman[-1])
    print("Word:", " ".join(word))
    print("Game Over!")
    print("You failed to guess the word.")
