
import random
import os


# Clears the terminal screen.
def clear_screen():
    os.system("cls" if os.name == "nt" else "clear")


def play_game():
    # Create an empty board for Tic-Tac-Toe.
    board = [" "] * 9

    # Display the Tic-Tac-Toe board.
    def display_board():
        print()
        print(" " + board[0] + " | " + board[1] + " | " + board[2])
        print("---+---+---")
        print(" " + board[3] + " | " + board[4] + " | " + board[5])
        print("---+---+---")
        print(" " + board[6] + " | " + board[7] + " | " + board[8])
        print()

    # Check whether a player has won.
    def check_winner(symbol):
        winning_combinations = [
            [0, 1, 2], [3, 4, 5], [6, 7, 8],
            [0, 3, 6], [1, 4, 7], [2, 5, 8],
            [0, 4, 8], [2, 4, 6]
        ]

        for combination in winning_combinations:
            if all(board[position] == symbol for position in combination):
                return True

        return False

    # Find a winning move or a move to block the player.
    def find_best_move(symbol):
        for position in range(9):
            if board[position] == " ":
                board[position] = symbol

                if check_winner(symbol):
                    board[position] = " "
                    return position

                board[position] = " "

        return None

    # Keep playing rounds until the player wins.
    while True:
        board = [" "] * 9

        clear_screen()
        print("Welcome to Puzzle 3: Tic-Tac-Toe!")
        print("You are X and the computer is O.")
        print("Choose a position from 1 to 9.")

        # Continue playing until this round ends.
        while True:
            display_board()

            # Ask the player to choose a position.
            try:
                move = int(input("Choose a position (1-9): ")) - 1
            except ValueError:
                print("Please enter a number from 1 to 9.")
                input("Press Enter to try again...")
                clear_screen()
                print("Welcome to Puzzle 3: Tic-Tac-Toe!")
                print("You are X and the computer is O.")
                continue

            # Check that the position is valid and empty.
            if move < 0 or move > 8 or board[move] != " ":
                print("Invalid move! Choose an empty position from 1 to 9.")
                input("Press Enter to try again...")
                clear_screen()
                print("Welcome to Puzzle 3: Tic-Tac-Toe!")
                print("You are X and the computer is O.")
                continue

            # Place the player's symbol on the board.
            board[move] = "X"

            # Check whether the player has won.
            if check_winner("X"):
                clear_screen()
                print("Welcome to Puzzle 3: Tic-Tac-Toe!")
                display_board()
                print("Congratulations! You beat the computer!")
                print("You can proceed to the next room.")
                return True

            # Check whether the board is full after the player's move.
            if all(space != " " for space in board):
                print("It's a tie! Starting a new round...")
                input("Press Enter to continue...")
                break

            # Clear the screen before the computer's turn.
            clear_screen()
            print("Welcome to Puzzle 3: Tic-Tac-Toe!")
            print("You are X and the computer is O.")
            display_board()

            # Computer tries to win first.
            computer_move = find_best_move("O")

            # If the computer cannot win, try to block the player.
            if computer_move is None:
                computer_move = find_best_move("X")

            # If there is no winning or blocking move, choose a position.
            if computer_move is None:
                if board[4] == " ":
                    computer_move = 4
                else:
                    available_corners = [
                        position for position in [0, 2, 6, 8]
                        if board[position] == " "
                    ]

                    if available_corners:
                        computer_move = random.choice(available_corners)
                    else:
                        available_positions = [
                            position for position in range(9)
                            if board[position] == " "
                        ]
                        computer_move = random.choice(available_positions)

            # Place the computer's symbol on the board.
            board[computer_move] = "O"

            # Check whether the computer has won.
            if check_winner("O"):
                clear_screen()
                print("Welcome to Puzzle 3: Tic-Tac-Toe!")
                display_board()
                print("The computer won! Starting a new round...")
                input("Press Enter to continue...")
                break

            # Check whether the board is full after the computer's move.
            if all(space != " " for space in board):
                clear_screen()
                print("It's a tie! Starting a new round...")
                input("Press Enter to continue...")
                break

            # Clear the screen after the computer's turn.
            clear_screen()
            print("Welcome to Puzzle 3: Tic-Tac-Toe!")
            print("You are X and the computer is O.")
            print("The computer chose position", computer_move + 1)


# Runs the game when this file is executed directly.
if __name__ == "__main__":
    play_game()
